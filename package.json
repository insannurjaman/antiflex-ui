{
  "name": "antiflex-foundation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "brand:build": "node scripts/build-brand-assets.mjs",
    "dev": "npm --prefix apps/docs run dev --",
    "build": "pnpm tokens:build && pnpm --filter @antiflex/ui build && pnpm --filter @antiflex/docs build",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @antiflex/storybook dev",
    "storybook:build": "pnpm --filter @antiflex/storybook build",
    "test": "playwright test",
    "check": "pnpm tokens:check && pnpm tokens:test && pnpm registry:check && pnpm installer:test && pnpm typecheck && pnpm build && pnpm storybook:build && pnpm test",
    "figma:build": "node scripts/build-figma.mjs",
    "previews": "node scripts/capture-previews.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "installer:test": "node --test tests/installer.test.mjs",
    "installer:pack": "pnpm --filter antiflex-ui build && pnpm --filter antiflex-ui pack --pack-destination artifacts",
    "installer:smoke": "node scripts/verify-installer.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "deploy:prepare": "node scripts/prepare-deployment.mjs",
    "figma:forms": "node scripts/build-form-figma.mjs",
    "figma:feedback": "node scripts/build-feedback-figma.mjs",
    "figma:modals": "node scripts/build-modal-figma.mjs",
    "figma:floating": "node scripts/build-floating-figma.mjs",
    "figma:panels": "node scripts/build-panel-figma.mjs",
    "tokens:reference": "node scripts/sync-reference-foundations.mjs",
    "tokens:test": "node --test tests/tokens.test.mjs",
    "figma:foundations-expanded": "node scripts/build-expanded-foundations-figma.mjs",
    "figma:menus": "node scripts/build-menu-figma.mjs",
    "figma:toast": "node scripts/build-toast-figma.mjs",
    "figma:workspace": "node scripts/build-expansion-figma.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
